generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// 用户模型
// ============================================

model User {
  id            String    @id @default(uuid())
  email         String?   @unique
  name          String    @default("本地用户")
  
  configs       Config[]
  assets        Asset[]
  folders       Folder[]
  projects      Project[]
  workflows     WorkflowTemplate[]
  canvasProjects CanvasProject[]
  marketingTasks MarketingTask[]
  modelConfigs   ModelConfig[]
  searchServices SearchServiceConfig[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([email])
}

// ============================================
// 配置管理
// ============================================

model Config {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type          String
  provider      String?
  apiKey        String?
  baseURL       String?
  model         String?
  relayType     String?
  
  maxConcurrent Int?      @default(50)
  
  preferences   Json?
  isActive      Boolean   @default(true)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@unique([userId, type, provider])
  @@index([userId, type])
}

// ============================================
// 服务端模型配置
// ============================================

model ModelConfig {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  name            String
  provider        String    @default("openai")
  relayType       String?
  baseURL         String
  model           String
  apiProtocol     String    @default("chat_completions")
  apiKeyEncrypted String    @db.Text
  capabilities    Json
  isActive        Boolean   @default(true)
  isDefault       Boolean   @default(false)

  // 能力实测结果（V3 5.2）：营销生成前据此预检
  lastTestedAt       DateTime?
  testStatus         String?   // passed/partial/failed
  testedCapabilities Json?     // 实测通过的 connection/jsonMode/vision
  testError          String?   // 脱敏错误摘要

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, name])
  @@index([userId, isActive])
}

// ============================================
// 资源库
// ============================================

model Asset {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  filename        String
  filepath        String    @unique
  thumbnail       String?
  filesize        Int
  
  width           Int?
  height          Int?
  format          String
  
  prompt          String?   @db.Text
  negativePrompt  String?   @db.Text
  aiModel         String?
  aiProvider      String?
  parameters      Json?
  
  folderId        String?
  folder          Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tags            Tag[]
  
  source          String
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // 营销助手2资产版本追踪（V2 6.3）
  marketingTaskId String?
  parentAssetId   String?
  revision        Int       @default(1)
  derivedReason   String?
  stepKey         String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([userId, createdAt])
  @@index([folderId])
  @@index([source])
  @@index([marketingTaskId])
  @@index([parentAssetId])
}

model Folder {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name        String
  description String?
  color       String?
  
  parentId    String?
  parent      Folder?   @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Folder[]  @relation("FolderHierarchy")
  
  assets      Asset[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@unique([userId, parentId, name])
  @@index([userId, parentId])
}

model Tag {
  id          String    @id @default(uuid())
  name        String    @unique
  color       String?
  description String?
  
  assets      Asset[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([name])
}

// ============================================
// 项目管理
// ============================================

model Project {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name        String
  description String?   @db.Text
  
  assets      Asset[]
  workflows   WorkflowTemplate[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([userId])
}

// ============================================
// 工作流系统
// ============================================

model WorkflowTemplate {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name        String
  description String?   @db.Text
  
  definition  Json
  
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([userId])
}

// ============================================
// 无限画布项目（仓库模式：/canvas 列表 → /canvas/[id] 编辑器）
// definition 为 version 2 复合格式：{ version, fabric, nodes, connections, viewport }
// ============================================

model CanvasProject {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String
  thumbnail  String?  @db.Text // 导出 PNG 的 dataURL，用于仓库卡片预览
  definition Json

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, updatedAt])
}

// ============================================
// 电商营销任务
// ============================================

model MarketingTask {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 产品信息
  productName     String
  productImages   String[]  // 产品图URL数组
  category        String?   // 品类
  platform        String    // 目标平台
  language        String    @default("zh-CN")

  // 分析结果
  analysis        Json?     // 产品识别报告

  // 生成结果
  copywriting     Json?     // 文案结果
  mainPrompts     Json?     // 主图提示词
  detailPrompts   Json?     // 详情页提示词

  // 用户输入
  sellPoints      String[]  // 核心卖点
  keywords        String[]  // 目标关键词
  parameters      Json?     // 产品参数

  // 模型与执行记录（不含 API Key）
  modelSnapshot   Json?
  executionSteps  Json?

  status          String    @default("draft") // draft/analyzing/completed/failed
  error           String?   // 错误信息

  // V3 新增字段（2026-08-13）
  module          String    @default("copywriting") // copywriting/translate/seo/geo/insight
  input           Json?     // 版本化输入快照（不含密钥）
  result          Json?     // 统一结果快照
  selectedOutputs String[]  @default([]) // 用户选择的输出项
  isFavorite      Boolean   @default(false)
  schemaVersion   Int       @default(1)

  // V3 Phase 6 异步字段
  cancelRequestedAt DateTime?
  items           MarketingTaskItem[]
  events          MarketingTaskEvent[]

  // 营销助手2工作流字段（V2 6.1）
  workflowKey     String?   // 注册表工作流 key（marketing2-*）
  workflowVersion Int       @default(1)
  currentStep     String?   // 当前阶段 stepKey
  taskVersion     Int       @default(1) // 乐观锁版本号
  awaitingReview  Boolean   @default(false)
  stepModels      Json?     // stepKey -> modelId 选择快照
  stepResults     Json?     // stepKey -> 审批后的步骤结果版本
  pausedAt        DateTime? // 批量生图暂停标记
  createIdempotencyKey String? // 创建营销助手2任务的幂等键

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status])
  @@index([userId, module, isFavorite])
  @@index([userId, workflowKey])
  @@unique([userId, createIdempotencyKey])
}

// ============================================
// 营销任务子项（V3 Phase 6）
// 任务拆分为可独立执行、领取、重试与取消的 item。
// 租约（leaseOwner + leaseExpiresAt）防止多 Worker 重复执行。
// ============================================

model MarketingTaskItem {
  id             String    @id @default(uuid())
  taskId         String
  task           MarketingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId         String

  // analysis/copywriting/mainPrompts/detailPrompts/translate:<lang>/seo/geo/insight:<type>
  kind           String
  role           String?   // vision/content
  modelId        String?
  dependsOn      String?   // 依赖的前置 item kind（如 analysis）

  status         String    @default("pending") // pending/running/awaiting_review/completed/failed/skipped/cancelled
  attempts       Int       @default(0)
  maxAttempts    Int       @default(1)
  input          Json?     // 该 item 的输入快照（不含密钥）
  result         Json?     // 输出快照
  error          String?

  // 营销助手2字段（V2 6.2）
  stepKey        String?
  itemVersion    Int       @default(1)
  idempotencyKey String?   @unique

  leaseOwner     String?
  leaseExpiresAt DateTime?
  startedAt      DateTime?
  completedAt    DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, taskId])
  @@index([status, leaseExpiresAt])
  @@index([taskId, createdAt])
  @@index([taskId, stepKey])
}

// ============================================
// 营销任务事件（V3 Phase 6）
// 审计事件流：状态变更、取消与重试可追溯；支持游标分页与 SSE。
// ============================================

model MarketingTaskEvent {
  id        String   @id @default(uuid())
  taskId    String
  task      MarketingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  itemId    String?
  type      String   // task_created/item_started/item_completed/item_failed/item_retried/task_completed/task_failed/task_cancelled/cancel_requested
  payload   Json?
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
  @@index([userId, createdAt])
}

// ============================================
// 搜索服务配置（V3 Phase 7）
// 联网搜索供应商配置：密钥仅存服务端，实测通过后才可用于联网模块。
// ============================================

model SearchServiceConfig {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  name            String
  provider        String    @default("tavily") // tavily/serper/custom
  baseURL         String
  apiKeyEncrypted String    @db.Text
  isActive        Boolean   @default(true)
  isDefault       Boolean   @default(false)

  lastTestedAt    DateTime?
  testStatus      String?   // passed/failed
  testError       String?

  maxQueriesPerTask Int     @default(12)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, name])
  @@index([userId, isActive])
}
